# --- Supabase / PostgreSQL ---
# These are pre-populated in the Bolt environment. For local setup, copy from your Supabase project.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- OpenAQ API ---
# Get a free API key at https://docs.openaq.org/
OPENAQ_API_KEY=your-openaq-api-key
OPENAQ_API_BASE=https://api.openaq.org/v3

# --- Open-Meteo API ---
# Open-Meteo is free and does not require an API key
OPENMETEO_API_BASE=https://archive-api.open-meteo.com/v1/archive

# --- Pipeline Settings ---
REQUEST_TIMEOUT=30
REQUEST_RETRIES=3
USE_SAMPLE_FALLBACK=true
